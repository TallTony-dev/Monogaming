            "DrawBox": {
                "X": 50,
                "Y": 20,
                "Width": 200,
                "Height": 100
            },
            "TextureHandler": {
                "textures": {
                    "Default": "buttonRock.Unpressed",
                    "OnHover": "buttonRock.Unpressed"
                }
            },
            "OnClickActions": [
                {
                    "CommandName": "EnterMainGame"
                }
