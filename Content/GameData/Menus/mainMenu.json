                    "DrawBox": {
                        "X": 0,
                        "Y": 0,
                        "Width": 64,
                        "Height": 32
                    },

                    "Text": "Start"
                }
            ]
        },

        "EditorEnter": {
            "ElementType": "buttonElement",
            "ID": "editorButton",
