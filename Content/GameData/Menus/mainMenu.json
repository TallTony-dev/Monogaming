{
    "ElementType": "baseElement",
    "ID": "root",
    "Anchor": "TopLeft",
    "Children": [
        {
            "ElementType": "buttonElement",
            "ID": "startButton",
            "Anchor": "TopLeft",

            "DrawBox": {
                "X": 50,
                "Y": 20,
                "Width": 200,
                "Height": 100
            },
            "TextureHandler": {
                "textures": {
                    "Default": "buttonRock.Unpressed",
                    "OnHover": "buttonRock.Unpressed"
                }
            },
            "OnClickActions": [
                {
                    "CommandName": "EnterMainGame"
                }
            ],

            "Text": "Start"
        },

        {
            "ElementType": "buttonElement",
            "ID": "uiEditorButton",
            "Anchor": "BottomRight",
            "DrawBox": {
                "X": -10,
                "Y": -10,
                "Width": 200,
                "Height": 100
            },
            "TextureHandler": {
                "textures": {
                    "Default": "buttonRock.Unpressed",
                    "OnHover": "buttonRock.Unpressed"
                }
            },
            "OnClickActions": [
                {
                    "CommandName": "EnterUiEditor"
                },
                {
                    "CommandName": "DeactivateElement",
                    "Args": "mainMenu"
                }
            ],

            "Text": "Ui Editor"
        },
        {
            "ElementType": "buttonElement",
            "ID": "deserializingButton",
            "Anchor": "BottomLeft",
            "DrawBox": {
                "X": 10,
                "Y": -10,
                "Width": 200,
                "Height": 100
            },
            "TextureHandler": {
                "textures": {
                    "Default": "buttonRock.Unpressed",
                    "OnHover": "buttonRock.Unpressed"
