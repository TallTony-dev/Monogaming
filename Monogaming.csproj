<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <EnableGameDataSync>true</EnableGameDataSync> 
    <!-- EnableGameDataSync sets if the gamedata folder should be backcopied on build (llm) -->
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Apos.Input" Version="2.5.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Content\GameData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>GameData\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <Target Name="SyncGeneratedGameDataFromOutput" BeforeTargets="Build" Condition="'$(EnableGameDataSync)' == 'true'">
    <PropertyGroup>
      <_BuiltGameDataRoot>$(OutputPath)GameData\</_BuiltGameDataRoot>
      <_ProjectGameDataRoot>$(MSBuildProjectDirectory)\Content\GameData\</_ProjectGameDataRoot>
    </PropertyGroup>

    <ItemGroup>
      <_GeneratedGameDataFiles Include="$(_BuiltGameDataRoot)**\*" Condition="Exists('$(_BuiltGameDataRoot)')" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_GeneratedGameDataFiles)"
      DestinationFiles="@(_GeneratedGameDataFiles->'$(_ProjectGameDataRoot)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_GeneratedGameDataFiles)' != ''" />
  </Target>
</Project>